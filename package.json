{
  "name": "star-rail-personal-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "db:up": "docker compose up -d",
    "db:push": "npm run db:push --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "music:sync": "npm run music:sync --prefix backend",
    "gif:doro": "python scripts/process-doro-gif.py",
    "deploy": "node scripts/deploy-remote.mjs",
    "deploy:ps1": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "deploy:update": "node scripts/remote-update.mjs",
    "setup": "npm run install:all && npm run db:up && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  }
}
