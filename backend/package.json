{
  "name": "star-rail-web-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:push": "prisma db push --schema prisma/schema.sqlite.prisma",
    "db:push:prod": "prisma db push --schema prisma/schema.mysql.prisma",
    "db:generate:prod": "prisma generate --schema prisma/schema.mysql.prisma",
    "db:setup": "prisma db push --schema prisma/schema.sqlite.prisma --skip-generate && prisma generate --schema prisma/schema.sqlite.prisma && npm run characters:seed",
    "dev:prepare": "tsx scripts/dev-prepare.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "music:sync": "tsx scripts/sync-music.ts",
    "characters:seed": "tsx scripts/seed-characters.ts",
    "characters:cache": "tsx scripts/cache-character-icons.ts",
    "characters:refresh": "tsx scripts/seed-characters.ts && tsx scripts/cache-character-icons.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "sanitize-html": "^2.17.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.21",
    "@types/sanitize-html": "^2.16.0",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
